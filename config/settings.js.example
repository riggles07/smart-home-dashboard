/**
 * Node-RED settings -- Smart Home Dashboard
 *
 * Only keys documented at
 *   https://nodered.org/docs/user-guide/runtime/configuration
 * are used here.
 *
 * DO NOT add keys that are not part of Node-RED's settings schema. Common
 * fabrications that will break the file or be silently ignored:
 *   flowFiles  plugins  server  ui.theme  ui.css  ui.tabs  ui.order
 *   functionRepo  projectsDir  httpStaticHeaders
 * There is exactly ONE flow file option: `flowFile`.
 *
 * Verify any edit before restarting:
 *   node --check /root/.node-red/settings.js
 *   node -e "require('/root/.node-red/settings.js'); console.log('loads OK')"
 */

module.exports = {
    // ---------------------------------------------------------------------
    // Runtime
    // ---------------------------------------------------------------------

    // Directory holding user data (flows, credentials, library).
    // Default is $HOME/.node-red -- for root that is already /root/.node-red,
    // so this line is optional. It is a real setting; `functionRepo` and
    // `projectsDir` are not.
    userDir: process.env.NODE_RED_USERDIR || "/root/.node-red",

    // The file (relative to userDir, or absolute) that stores the flows.
    flowFile: "flows.json",

    // Write the flow file with indentation so diffs are readable.
    flowFilePretty: true,

    // Editor/API port. Default 1880.
    uiPort: process.env.NODE_RED_PORT || 1880,

    // Secret used to encrypt the credentials file. Set this to a fixed value:
    // if it changes, stored credentials become unreadable. Not needed by this
    // project (the flows read secrets from the environment, not from
    // credential nodes), but harmless and good practice.
    credentialSecret: process.env.NODE_RED_CREDENTIAL_SECRET || "shd-local-secret",

    // ---------------------------------------------------------------------
    // Dashboard (node-red-dashboard)
    // ---------------------------------------------------------------------
    // `path` is the ONLY dashboard runtime setting. Everything else about the
    // dashboard (theme, tabs, layout, css) is configured in the editor UI, not
    // here. Default path is "ui".
    ui: { path: "ui" },

    // ---------------------------------------------------------------------
    // Logging
    // ---------------------------------------------------------------------
    logging: {
        console: { level: process.env.NODE_RED_LOG_LEVEL || "info" }
    }

    // ---------------------------------------------------------------------
    // Admin authentication -- disabled to match the current setup.
    // To enable, uncomment and generate a real hash first:
    //   node-red admin hash-pw
    // Never hand-write a placeholder hash; bcrypt hashes must be valid or
    // login breaks.
    // ---------------------------------------------------------------------
    // adminAuth: {
    //     type: "credentials",
    //     users: [{
    //         username: process.env.NODE_RED_USER || "admin",
    //         password: "$2b$08$REPLACE_WITH_HASH_FROM_node-red_admin_hash-pw",
    //         permissions: "*"
    //     }]
    // },

    // ---------------------------------------------------------------------
    // HTTPS -- disabled; this instance serves plain HTTP on uiPort.
    // To enable, uncomment and provide real certificate files. `https` is the
    // real key; `server` is not.
    // ---------------------------------------------------------------------
    // https: {
    //     key:  require("fs").readFileSync("/etc/node-red/private.key"),
    //     cert: require("fs").readFileSync("/etc/node-red/fullchain.pem")
    // },
};
