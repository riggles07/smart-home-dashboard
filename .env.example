NODE_RED_USER=admin
NODE_RED_PASS=admin
NODE_RED_HOST=localhost
NODE_RED_PORT=1880
NODE_RED_SECURE=false

# Proxmox Settings
PROXMOX_HOST=proxmox.local
PROXMOX_PORT=8006
PROXMOX_USER=root@pam
PROXMOX_PASS=your_password

# Hubitat Settings
HUBITAT_URL=http://hubitat.local:80
HUBITAT_USERNAME=your_username
HUBITAT_PASSWORD=your_password
HUBITAT_API_KEY=your_api_key

# Maker API (device controls / automation triggers)
# App id from the Maker API app URL: http://[hub]/apps/api/[app_id]/...
HUBITAT_APP_ID=your_maker_api_app_id
# Access token from the same page; falls back to HUBITAT_API_KEY when unset
HUBITAT_ACCESS_TOKEN=your_maker_api_access_token

# UniFi Settings
UNIFI_HOST=unifi.local
UNIFI_PORT=8443
UNIFI_USERNAME=your_username
UNIFI_PASSWORD=your_password
UNIFI_SITE=default
