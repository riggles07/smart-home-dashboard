  {
    "id": "e24cd17178a0d001",
    "type": "ui_template",
    "z": "9171e542e4309e3f",
    "name": "Cards",
    "group": "e1f9a25b6ae24226",
    "order": 3,
    "width": "12",
    "height": "8",
    "format": "<table class='table' style='width:100%'>\n  <thead><tr><th>Task</th><th>Status</th></tr></thead>\n  <tbody>\n    <tr ng-repeat='c in msg.payload'>\n      <td>{{c.task}}</td><td>{{c.status}}</td>\n    </tr>\n  </tbody>\n</table>",
