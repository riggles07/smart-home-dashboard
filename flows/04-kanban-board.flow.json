  {
    "id": "5c6df7c479179e47",
    "type": "function",
    "z": "9171e542e4309e3f",
    "name": "Add card",
    "func": "var task = (typeof msg.payload === 'string' ? msg.payload : '').trim();\nif (!task) { node.status({fill:'grey',shape:'ring',text:'empty'}); return null; }\nvar cards = flow.get('kanban_cards') || [];\ncards.push({task: task, status: 'todo'});\nflow.set('kanban_cards', cards);\nnode.status({fill:'green',shape:'dot',text:cards.length + ' cards'});\nmsg.payload = cards;\nreturn [msg, msg];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "flow.set('kanban_cards', flow.get('kanban_cards') || []);",
    "finalize": "",
    "libs": [],
    "x": 350,
    "y": 120,
    "wires": [
