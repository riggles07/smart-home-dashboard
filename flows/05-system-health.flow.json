  {
    "id": "799caa8a2d5cf7be",
    "type": "function",
    "z": "61550c749f923be9",
    "name": "Evaluate alerts",
    "func": "// System Health alert banner: Prometheus targets/probes + node pressure.\n// Parse health summary attaches the full stat map to its first output,\n// so one message evaluates the whole stack.\nvar m = msg.stats || {};\nvar cpu = m.pve_cpu, mem = m.pve_mem;\nvar tUp = m.targets_up, tTot = m.targets_total;\nvar pOk = m.probes_ok, pTot = m.probes_total;\nfunction pct(v) { return Math.round(v * 10) / 10 + '%'; }\nfunction escalate(s) {\n  if (s === 'critical') { sev = 'critical'; }\n  else if (s === 'warning' && sev !== 'critical') { sev = 'warning'; }\n}\nvar sev = 'ok';\nvar parts = [];\nif (!m || msg.payload === -1) {\n  // Parse health summary marks total failure with payload:-1 (stats\n  // null) or payload:-1 + empty stats (Prometheus up, nothing scraped).\n  sev = 'critical';\n  parts.push('Monitoring data unavailable');\n} else {\nif (typeof cpu === 'number') {\n  if (cpu >= 90) { escalate('critical'); parts.push('CPU ' + pct(cpu)); }\n  else if (cpu >= 75) { escalate('warning'); parts.push('CPU ' + pct(cpu)); }\n}\nif (typeof mem === 'number') {\n  if (mem >= 90) { escalate('critical'); parts.push('Memory ' + pct(mem)); }\n  else if (mem >= 75) { escalate('warning'); parts.push('Memory ' + pct(mem)); }\n}\nif (tTot > 0 && tUp < tTot) {\n  escalate(tUp === 0 ? 'critical' : 'warning');\n  parts.push('Targets ' + tUp + '/' + tTot);\n}\nif (pTot > 0 && pOk < pTot) {\n  escalate(pOk === 0 ? 'critical' : 'warning');\n  parts.push('Probes ' + pOk + '/' + pTot);\n}\nif (sev === 'ok') { parts.push('All monitored systems healthy'); }\n}\nnode.status({fill: sev === 'ok' ? 'green' : (sev === 'critical' ? 'red' : 'yellow'), shape: 'dot', text: sev});\nmsg.payload = {severity: sev, message: parts.join(' | ')};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1020,
    "y": 120,
    "wires": [
      [
        "e5291e1ed1c0e27c"
      ]
    ]
