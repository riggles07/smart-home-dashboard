  {
    "id": "025dac0d1c93aa91",
    "type": "function",
    "z": "61550c749f923be9",
    "name": "Build health query",
    "func": "// One instant query returns every summary stat, tagged with a `stat`\n// label so a single HTTP round trip feeds all five widgets. Every\n// expression was verified live against the co-located stack.\nvar base = (env.get('PROMETHEUS_URL') || 'http://192.168.4.145:9090').replace(/\\/+$/, '');\nvar q = 'label_replace(count(up == 1), \"stat\", \"targets_up\", \"\", \"\")'\n  + ' or label_replace(count(up), \"stat\", \"targets_total\", \"\", \"\")'\n  + ' or label_replace(100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100), \"stat\", \"pve_cpu\", \"\", \"\")'\n  + ' or label_replace(100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)), \"stat\", \"pve_mem\", \"\", \"\")'\n  + ' or label_replace(count(probe_success == 1), \"stat\", \"probes_ok\", \"\", \"\")'\n  + ' or label_replace(count(probe_success), \"stat\", \"probes_total\", \"\", \"\")'\n  + ' or label_replace((time() - node_boot_time_seconds) / 86400, \"stat\", \"pve_uptime_days\", \"\", \"\")';\nmsg.method = 'GET';\nmsg.url = base + '/api/v1/query?query=' + encodeURIComponent(q);\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 350,
    "y": 120,
    "wires": [
      [
        "39e86171498a2ca6"
      ]
    ]
