  {
    "id": "0920bfc12f1795af",
    "type": "function",
    "z": "61550c749f923be9",
    "name": "Build Grafana embeds",
    "func": "// d-solo renders ONE panel without the Grafana chrome -- the correct\n// route for iframes. kiosk strips the remaining nav, theme=dark avoids\n// a light flash against the dashboard's dark theme, and refresh=30s\n// lets the panel refresh itself WITHOUT the iframe being reloaded\n// (each template's <script> only touches src when the URL changes,\n// so the repeating inject re-pushes the SAME string and the SPA is\n// never torn down).\n// The Grafana server must run with allow_embedding=true and anonymous\n// Viewer access -- see docs/GRAFANA_INTEGRATION.md.\nvar base = (env.get('GRAFANA_URL') || 'http://192.168.4.145:3001').replace(/\\/+$/, '');\nvar uid  = env.get('GRAFANA_DASH_UID') || 'shd-system-health';\nfunction solo(panelId) {\n  return base + '/d-solo/' + uid + '/system-health?orgId=1&panelId=' + panelId\n       + '&kiosk&theme=dark&from=now-3h&to=now&refresh=30s';\n}\nmsg.p = {\n  cpu: solo(1), mem: solo(2), io: solo(3),\n  health: solo(4), latency: solo(6), loss: solo(7)\n};\nnode.status({fill:'green',shape:'dot',text:'embeds ready'});\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 370,
    "y": 480,
    "wires": [
