    "group": "0792acaebf00ac56",
    "order": 1,
    "width": "12",
    "height": "8",
    "format": "<div class=\"shd-embed\">\n<iframe class=\"shd-grafana-frame\" id=\"shd-frame-cpu\" title=\"Proxmox Node CPU\" loading=\"lazy\"></iframe>\n</div>\n<script>\n(function(scope) {\n  var key = 'cpu';\n  var frame = null;\n  scope.$watch(\n    function() { return scope.msg && scope.msg.p && scope.msg.p[key]; },\n    function(url) {\n      if (!url || typeof url !== 'string') { return; }\n      if (!frame) { frame = document.getElementById('shd-frame-cpu'); }\n      if (!frame) { return; }\n      // Reload-storm guard: the repeating inject re-pushes the SAME URL\n      // string, so only the first assignment hits the DOM and the Grafana\n      // SPA is never torn down. getAttribute returns the exact assigned\n      // string, so browser URL-normalisation cannot re-trigger it.\n      if (frame.getAttribute('src') !== url) { frame.src = url; }\n    });\n})(scope);\n</script>",
