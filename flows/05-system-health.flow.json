  {
    "id": "3a60013f3e07f4a7",
    "type": "function",
    "z": "61550c749f923be9",
    "name": "Parse health summary",
    "func": "// Map the stat-labelled instant query onto one message per widget.\n// Missing stats degrade to 0 rather than 'undefined' text.\nvar r = msg.payload;\nif (!r || r.status !== 'success' || !r.data || !Array.isArray(r.data.result)) {\n  node.status({fill:'red',shape:'ring',text:'no data'});\n  // out0 feeds the alert evaluator. An empty stat map would read as\n  // 'everything healthy' there -- send stats: null so the banner\n  // reports 'monitoring unavailable' (critical) instead of lying.\n  var mFail = { payload: -1, stats: null };\n  return [mFail, null, null, null, null];\n}\nvar m = {};\nr.data.result.forEach(function (s) {\n  if (s.metric && s.metric.stat && s.value) { m[s.metric.stat] = parseFloat(s.value[1]); }\n});\n// Prometheus reachable but zero stats scraped: same as down for\n// alerting purposes -- the banner must not read it as 'healthy'.\nif (!m.targets_total && !m.probes_total && !m.pve_cpu && !m.pve_mem) {\n  var mNone = { payload: -1, stats: {} };\n  return [mNone, null, null, null, null];\n}\nfunction pct(v) { return isFinite(v) ? Math.round(v * 10) / 10 : 0; }\nvar mCpu = { payload: pct(m.pve_cpu), stats: m };\nvar mMem = { payload: pct(m.pve_mem) };\nvar mTgt = { payload: Math.round(m.targets_up || 0) + ' / ' + Math.round(m.targets_total || 0) + ' up' };\nvar mPrb = { payload: Math.round(m.probes_ok || 0) + ' / ' + Math.round(m.probes_total || 0) + ' ok' };\nvar mUp  = { payload: pct(m.pve_uptime_days) + ' days' };\nnode.status({fill:'green',shape:'dot',text:'ok'});\nreturn [mCpu, mMem, mTgt, mPrb, mUp];",
    "outputs": 5,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
