    "z": "1292414d65358a68",
    "name": "Split client data",
    "func": "var rows = [];\nvar data = msg.payload && msg.payload.data ? msg.payload.data : [];\ndata.forEach(function (c) {\n  rows.push({hostname: c.hostname || c.name || c.mac, ip: c.ip || '', mac: c.mac || ''});\n});\nnode.status({fill:'green',shape:'dot',text:rows.length + ' clients'});\nreturn [ {payload: rows.length}, {payload: rows} ];",
