  {
    "id": "eccb2ee646eab148",
    "type": "function",
    "z": "1292414d65358a68",
    "name": "Build UniFi request",
    "func": "// UniFi controller API -- credentials from env vars, never hardcoded.\nvar base = env.get('UNIFI_URL') || 'https://unifi.local:8443';\nmsg.method = 'GET';\nmsg.url = base.replace(/\\/+$/, '') + '/api/s/default/stat/sta';\nmsg.headers = {'Accept': 'application/json'};\nmsg.rejectUnauthorized = false;\nnode.status({fill:'blue',shape:'dot',text:'polling'});\nreturn msg;",
