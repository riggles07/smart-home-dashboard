  {
    "id": "3955c5258b61b1cc",
    "type": "function",
    "z": "b30173dcd6d85862",
    "name": "Format result",
    "func": "if (msg.statusCode && msg.statusCode >= 200 && msg.statusCode < 300) {\n  node.status({fill:'green',shape:'dot',text:'ok'});\n  msg.payload = 'OK (' + msg.statusCode + ')';\n} else {\n  node.status({fill:'red',shape:'ring',text:'error'});\n  msg.payload = 'Error ' + (msg.statusCode || '') + ' ' + msg.payload;\n}\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
