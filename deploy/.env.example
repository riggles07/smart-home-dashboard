# SmartHome Dashboard - Environment Configuration Template
# Copy this file to .env and fill in your values
#
# Location: /home/node-red/.env
# Permissions: chmod 600 .env

# ============================================
# Node-RED Settings
# ============================================
NODE_RED_USER=admin
NODE_RED_PASS=admin
NODE_RED_HOST=localhost
NODE_RED_PORT=1880
NODE_RED_SECURE=false

# ============================================
# Hubitat Settings
# ============================================
# Hubitat API URL (default hubitat.local:80)
HUBITAT_URL=http://hubitat.local:80

# Hubitat credentials
HUBITAT_USERNAME=your_hubitat_username
HUBITAT_PASSWORD=your_hubitat_password
HUBITAT_API_KEY=your_hubitat_api_key

# ============================================
# UniFi Network Settings
# ============================================
# UniFi Controller hostname
UNIFI_HOST=unifi.local

# UniFi Controller port (8443 for HTTPS, 3478 for UDP)
UNIFI_PORT=8443

# UniFi credentials
UNIFI_USERNAME=your_unifi_username
UNIFI_PASSWORD=your_unifi_password

# UniFi site name (default: default)
UNIFI_SITE=default

# ============================================
# Proxmox/LXC Settings (Optional)
# ============================================
# Container ID
CONTAINER_ID=101

# Container IP address
CONTAINER_IP=192.168.1.100

# ============================================
# Advanced Settings
# ============================================
# Enable SSL (uncomment for production)
# NODE_RED_SECURE=true
# NODE_RED_KEY_PATH=/etc/ssl/private/nodered.key
# NODE_RED_CERT_PATH=/etc/ssl/certs/nodered.crt

# Enable Node-RED authentication (uncomment for production)
# NODERED_USER=admin
# NODERED_PASS=your_secure_password

# Enable logging
NODE_RED_LOG_LEVEL=info

# ============================================
# Notes
# ============================================
# - Never commit this file to version control
# - Use a password manager to store sensitive credentials
# - Rotate credentials regularly
# - Test connections after changing credentials
# - Restart Node-RED after changing environment variables
