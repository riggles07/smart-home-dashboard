# SmartHome Dashboard - Environment Configuration Template
# Copy this file to .env and fill in your values
#
# Location: /root/.node-red/.env     <-- NOT /home/node-red/.env
#   The systemd unit sets EnvironmentFile=-/root/.node-red/.env and runs with
#   userDir /root/.node-red. A file at /home/node-red/.env is never read.
#
# Permissions: chmod 600 .env
#
# !! NO INLINE COMMENTS AFTER A VALUE !!
#   systemd's EnvironmentFile parser does NOT strip them: an unquoted value runs
#   to end-of-line, so `HA_URL=http://x   # note` sets HA_URL to
#   "http://x   # note". bash `source`, dotenv and `docker --env-file` all DO
#   strip it -- so this passes every local check and breaks only inside the
#   running service. Put comments on their own line ABOVE the variable.
#
# If the vars never reach the process, check the unit first:
#   systemctl cat node-red | grep '^EnvironmentFile='
# A container provisioned before setup.sh began writing that line has none, so
# the file is read by nothing. Install it with `bash deploy/fix-env-loading.sh`
# (idempotent systemd drop-in). Restarting is required either way -- env is read
# at process start.
#
# This is the ONLY env template in the repo. A second root-level .env.example
# used to exist and had drifted: it omitted 7 variables the flows actually read
# and defined 13 that nothing reads. One template, checked against the flows.
#
# ---------------------------------------------------------------------------
# Variables read by the flows, grouped by requirement
# ---------------------------------------------------------------------------
# REQUIRED
#   HUBITAT_URL  HUBITAT_API_KEY  HUBITAT_APP_ID  HUBITAT_ACCESS_TOKEN
#   HUBITAT_DEVICE_ID
#   PROXMOX_URL  PROXMOX_TOKEN
#   UNIFI_URL
#   plus ONE of: UNIFI_API_KEY           (preferred; no login step)
#                UNIFI_USERNAME + UNIFI_PASSWORD
# OPTIONAL (safe to leave blank)
#   PROXMOX_NODE      defaults to "pve"
#   UNIFI_SITE        defaults to "default"
#   UNIFI_LOGIN_URL   auto-derived from UNIFI_URL
#   PROMETHEUS_URL    defaults to http://<monitoring-host>:9090
#   GRAFANA_URL       defaults to http://<monitoring-host>:3001
#   GRAFANA_DASH_UID  defaults to "shd-system-health"
#   HA_URL  HA_TOKEN  HA_ENTITY_ID  (Home Assistant tab; the tab is inert
#                                    until HA_TOKEN is set)
#
# To re-check this list against the code, extract env.get() names from the
# flows (see t_1ed4992c) -- do not trust the template by itself.

# ============================================
# Node-RED Settings
# ============================================
NODE_RED_USER=admin
NODE_RED_PASS=admin
NODE_RED_HOST=localhost
NODE_RED_PORT=1880
NODE_RED_SECURE=false

# ============================================


# Home Assistant integration
# HA_URL must be the address of HA's web UI AS REACHABLE FROM THE DASHBOARD
# CONTAINER. The flow derives the WebSocket URL by swapping http->ws and
# appending /api/websocket, so the UI and the WS API must be on the SAME port.
#   direct    : http://192.168.4.x:8123                     (HA default)
#   via proxy : http://homeassistant.<tailnet>.ts.net      (Tailscale Serve
#               often fronts HA on 80/443 -- NOT 8123)
# Verify before setting it -- this must print 401, never "ECONNREFUSED":
#   curl -i "$HA_URL/api/"        # 401 Unauthorized == HA is up and reachable
#   curl -i "$HA_URL/manifest.json"   # 200 + application/manifest+json
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your_home_assistant_long_lived_token
HA_ENTITY_ID=light.kitchen

# Hubitat Settings
# ============================================
# Hubitat hub URL (no path, no trailing slash)
HUBITAT_URL=http://192.168.4.86

# Hubitat Maker API token. The flows authenticate with a Maker API token, NOT a
# username/password pair -- HUBITAT_USERNAME / HUBITAT_PASSWORD are read by no
# flow and were removed (a leftover from when the integration used Basic auth).
HUBITAT_API_KEY=your_hubitat_api_key

# Hubitat Maker API (device control + automation triggers)
# App id from the Maker API app URL: http://[hub]/apps/api/[app_id]/...
HUBITAT_APP_ID=your_maker_api_app_id
# Access token from the same page (may be the same value as HUBITAT_API_KEY)
HUBITAT_ACCESS_TOKEN=your_maker_api_access_token
# Device id the Devices-tab power switch / brightness slider controls.
# Find it in the Maker API app page (or GET /apps/api/<app_id>/devices?access_token=<tok>).
HUBITAT_DEVICE_ID=your_device_id

# ============================================
# UniFi Network Settings
# ============================================
# UniFi Controller base URL (scheme + host + port + API prefix).
# Read by the Network-tab flow's function node.
#
#   UniFi OS (UDM / Cloud Gateway, port 443)  -> include /proxy/network:
#       UNIFI_URL=https://192.168.1.1/proxy/network
#   Self-hosted Network controller (8443)     -> root path, no prefix:
#       UNIFI_URL=https://192.168.1.1:8443
#
# Verify which one you have: a UniFi OS console returns "<title>UniFi OS</title>"
# at https://<host>/ . Get this wrong and the stat call 404s.
UNIFI_URL=https://192.168.1.1/proxy/network

# UniFi login endpoint. Leave blank to auto-derive: a UniFi OS base
# (containing /proxy/network) uses https://<host>/api/auth/login, anything else
# uses <UNIFI_URL>/api/login. Set this only to override that.
UNIFI_LOGIN_URL=

# UniFi Network 8+ API key (Settings -> Control Plane -> Integrations).
# If set, the flow uses X-API-KEY and never logs in.
UNIFI_API_KEY=

# UniFi credentials (used only when UNIFI_API_KEY is empty)
UNIFI_USERNAME=your_unifi_username
UNIFI_PASSWORD=your_unifi_password

# UniFi site name (default: default)
UNIFI_SITE=default

# ============================================
# Grafana / Prometheus (read by the System Health tab flow)
# ============================================
# Prometheus base URL -- feeds the summary stats and the health panels.
# Defaults to http://192.168.4.145:9090 when unset.
PROMETHEUS_URL=http://192.168.4.145:9090

# Grafana base URL. The server must run with allow_embedding=true and anonymous
# Viewer access, or the six d-solo iframes render blank.
# Defaults to http://192.168.4.145:3001 when unset.
GRAFANA_URL=http://192.168.4.145:3001

# Dashboard UID for the embedded panels (Grafana -> dashboard -> Settings -> UID).
# Defaults to "shd-system-health" when unset.
GRAFANA_DASH_UID=shd-system-health

# ============================================
# Proxmox/LXC Settings (Optional)
# ============================================
# Container ID
CONTAINER_ID=101

# Container IP address
CONTAINER_IP=192.168.1.100

# ============================================
# Proxmox API (read by the Home Lab tab flow)
# ============================================
# Proxmox API base URL (scheme + host + port)
PROXMOX_URL=https://proxmox.local:8006

# Node name shown in the Proxmox UI (Datacenter -> <node>)
PROXMOX_NODE=pve

# API token: Datacenter -> Permissions -> API Tokens -> Add
# Format: <user>@pam!<tokenid>=<secret>
PROXMOX_TOKEN=your_user@pam!dashboard=your-token-secret

# ============================================
# Advanced Settings
# ============================================
# Enable SSL (uncomment for production)
# NODE_RED_SECURE=true
# NODE_RED_KEY_PATH=/etc/ssl/private/nodered.key
# NODE_RED_CERT_PATH=/etc/ssl/certs/nodered.crt

# Enable Node-RED authentication (uncomment for production)
# NODERED_USER=admin
# NODERED_PASS=your_secure_password

# Enable logging
NODE_RED_LOG_LEVEL=info

# ============================================
# Notes
# ============================================
# - Never commit this file to version control
# - Use a password manager to store sensitive credentials
# - Rotate credentials regularly
# - Test connections after changing credentials
# - Restart Node-RED after changing environment variables
