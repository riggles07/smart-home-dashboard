# SmartHome Dashboard LXC Container Configuration
# Use with: qm create <id> --config <this_file> --memory <ram> --cores <cpus>
# Or import as template: qm importqemu <path/to/template>

# Container Settings
lxc.id = {{CONTAINER_ID}}
lxc.description = "SmartHome Dashboard - Node-RED Based"
lxc.arch = amd64
lxc.utsname = debian

# Root filesystem
lxc.rootfs.path = /var/lib/lxc/{{CONTAINER_ID}}/rootfs
lxc.rootfs.options = rw,nosuid,nodev,exec

# Network Configuration
lxc.network.type = veth
lxc.network.link = vmbr0
lxc.network.flags = up
lxc.network.ip4 = {{CONTAINER_IP}}
lxc.network.ip6 = 
lxc.network.hwaddr = 00:16:3e:00:00:00

# Console
lxc.console.type = tty
lxc.console.path = /var/lib/lxc/{{CONTAINER_ID}}/console

# Security Settings
lxc.apparmor.profile = unconfined
lxc.apparmor.allow_incomplete = true
lxc.apparmor.exec = false
lxc.cap.drop =

# Mounts
lxc.mount.auto = proc:rw sys:rw
lxc.mount.entry = /dev/ttyUSB0 /dev/ttyUSB0 bind,optional,create=file
lxc.mount.entry = /dev/ttyUSB1 /dev/ttyUSB1 bind,optional,create=file

# Resource Limits (optional, uncomment to enable)
# lxc.cgroup2.devices.allow = c 13 64:0 104857600 rw
# lxc.cgroup2.devices.allow = c 13 200:0 104857600 rw
